---
import { marked } from 'marked';
import { type CardsSection } from 'types';
import Action from '@components/Action.astro';
import Card from '@components/Card.astro';
import Section from '@components/Section.astro';

interface Props extends CardsSection {}

const { eyebrow, heading, body, items, columns, outro, cta, ...rest } = Astro.props;
---

<Section {...rest} class="text-center">
    {eyebrow && <p class="text-sm font-bold tracking-widest uppercase opacity-60">{eyebrow}</p>}
    {
        heading && (
            <h2 class:list={[eyebrow && 'mt-3', 'text-2xl font-black sm:text-4xl text-balance']}>
                {heading}
            </h2>
        )
    }
    {body && <div class:list={['mx-auto', heading && 'mt-4', 'max-w-prose markdown']} set:html={marked.parse(body)} />}
    {
        items && items?.length > 0 && (
            <div
                class:list={[
                    (heading || body) && 'mt-8',
                    'grid gap-8 justify-items-center',
                    columns === 'one' ? undefined : columns === 'two' ? 'md:grid-cols-2' : 'md:grid-cols-3'
                ]}
            >
                {items?.map((item) => (
                    <Card {...item} class="flex-1" />
                ))}
            </div>
        )
    }
    {outro && <div class="mx-auto mt-8 max-w-prose markdown" set:html={marked.parse(outro)} />}
    {
        cta && cta.length > 0 && (
            <div class="flex flex-wrap items-center justify-center gap-4 mt-8">
                {cta.map((item) => (
                    <Action action={item} />
                ))}
            </div>
        )
    }
</Section>
